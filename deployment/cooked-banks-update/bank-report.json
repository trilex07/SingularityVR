        "source_sha256": "748d8bd9c169993c86ebbabb6d57400bf7d77ed6326ac86785233dc02ace1873",
        "english": "The elevator will take you to the old rail line.",
        "polish": "Winda zabierze cię na starą linię kolejową.",
        "text_exact_match": true,
        "qa_recall": null,
        "qa_flagged": false,
        "true_peak_dbtp": -2.72,
