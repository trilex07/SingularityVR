        "source_sha256": "63d11a8e4fc3948658860a02156239a1a43684ec0e00285bc77f1869f4031972",
        "english": "Why don't you get on the elevator, Captain. It leads to the old rail line.",
        "polish": "Może wsiądzi pan na windę, kapitanie?",
        "text_exact_match": false,
        "qa_recall": null,
        "qa_flagged": false,
