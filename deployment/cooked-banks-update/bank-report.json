        "source_sha256": "6a5e7122f6090ea371078d936512e73d28d5e1b485b64df1a9f232c592b016eb",
        "english": "Captain, you should take the elevator to the old rail line.",
        "polish": "Kipton, weź windę do starej linii kolejowej.",
        "text_exact_match": false,
        "qa_recall": null,
        "qa_flagged": false,
        "true_peak_dbtp": -2.83,
        "tempo": 1.331942927948375,
