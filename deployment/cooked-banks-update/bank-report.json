        "source_sha256": "ad6c46bd10d3ea6c4954b97137c2335889b82bcb5ba66e64564e4ae6de0eb020",
        "english": "Go on. Take the elevator it leads to the old rail line.",
        "polish": "Weź windę, która prowadzi do linii.",
        "text_exact_match": false,
        "qa_recall": null,
        "qa_flagged": false,
        "true_peak_dbtp": -2.84,
        "tempo": 1.2867812890420072,
