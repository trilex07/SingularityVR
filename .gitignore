# ---- build output ----
/build/seeker-private/
/build/effects-review/
/build/accepted-profile-guard/
/build/frontend-menu-comfort/
/deployment/accepted-profile.json
/deployment/accepted-v7-promotion-*.json
/deployment/change-plan*.json
*.dll
*.exe
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.log
*.map
__pycache__/
*.pyc
# Private game-derived glove experiments; tools and synthetic tests are tracked.
/build/gloves/
/vr-assets/hud/katorga/glove-animation/
# /analyze output - build.ps1 runs a static-analysis pass, see the note in it
*.nativecodeanalysis.xml

# keep the OpenXR loader out - it is vendored at build time from the SDK
openxr_loader*.dll

# ---- run artefacts ----
last_run.log
run*.log

# ---- NEVER COMMIT ----
# Game-derived data. Ghidra projects contain a full analysis of the game binary, and
# save files are the user's own game data. Both live outside this tree by design; these
# entries exist so an accidental copy cannot slip in.
*.gpr
*.rep/
ghidra_projects/
save_backups/
*.ue3profile*

# extracted or decompiled game content of any kind
uscript/
*.upk
*.xxx
.local-notes/
/deployment/hands-dubbing/
/deployment/install-backups/
/deployment/install-reports/
/deployment/story-format-test-*/

# Claude Code local settings. Records absolute paths from this machine, including the
# home directory, so it must never reach the remote. A global ignore covered this before
# the remote moved; that protects one machine, not the repo.
.claude/settings.local.json

# ---- editor / OS ----
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# ---- release staging ----
# make-release.ps1 rebuilds both from source every run; nothing here is authored.
packaging/staging/
packaging/dist/
/deployment/texture-cache/

# ---- machine-specific build provenance ----
# Generated on each local build; repository paths and local working-tree state are embedded.
spikes/view_matrix/d3d9.build.json

# ---- external reference asset library ----
# Keep source archives and full reference rigs local; processed metadata and the small runtime
# prompt atlas are tracked separately.
assets/reference/**
assets/ui/kenney-input-prompts/kenney_input-prompts_*.zip
assets/ui/kenney-input-prompts/source/**

# ---- local Polish dubbing audio ----
# Generated/proprietary audio stays local (174 MB xlingual pack etc.); manifests,
# scripts, QA logs and casting docs ARE tracked.
audio/polish/story_voicepack_xlingual/**/*.wav
audio/polish/cast_legal_20261014/**/*.wav
audio/polish/cast_legal_20261014/**/*.mp3
audio/polish/cast_legal_20261014/**/*.m4a
audio/polish/cast_legal_20261014/**/*.ogg
audio/polish/cast_legal_20261014/**/*.exe
audio/polish/cast_legal_20261014/**/*.onnx
audio/polish/cast_legal_20261014/**/*.onnx.json

# ---- remaining-voices SIDE audio (252 MB): WAVy lokalnie, manifesty tak ----
remaining-voices/out/**/*.wav
remaining-voices/_refs/
_work_u/

# Local game-derived knife exports/cache; never distribute game assets in Git.
/build/knife/
/vr-assets/knife/
/build/knife-hand-grip/
/build/knife-shading-thumb/
