  {"id":"..\\RvGame\\Localization\\INT\\RvGame.int|Tutorial|Shotgun","category":"tutorial","en":"Press [switchwpn] once to switch to the shotgun.","pl":"Naciśnij raz [switchwpn], aby przełączyć się na strzelbę.","status":"translated"},
