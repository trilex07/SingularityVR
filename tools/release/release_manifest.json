{
  "$schema": "SingularityVR release manifest v1",
  "game": {
    "exe": "Binaries/Singularity.exe",
    "builds": [],
    "builds_note": "MAIN must pin supported Singularity.exe SHA-256 values here. Installer fails closed (or requires -ForceUnknownGameBuild) when empty."
  },
  "profiles": {
    "core": ["d3d9-dll", "openxr-loader", "vr-ini", "texture-injector-dll", "texture-injector-ini"],
    "localization": ["pl-text-pack", "pl-story-audio", "pl-ui-audio"],
    "hd-textures": ["texture-tier"],
    "experimental": ["glove-pack", "knife-pack", "ammo-plates-ammo", "ammo-plates-atlas", "health-plate", "vr-bik-boot", "vr-bik-loading", "ps-prompts"]
  },
  "components": [
    {
      "id": "d3d9-dll",
      "kind": "dll",
      "profile": "core",
      "required": true,
      "feature": "VR runtime (render, input, stereo, menus)",
      "source": {"type": "build", "path": "spikes/view_matrix/build.ps1", "output": "spikes/view_matrix/d3d9.dll"},
      "dest": "Binaries/d3d9.dll",
      "redistributable": true,
      "readiness": "needs-main-acceptance",
      "evidence": "x86 PE32 /O2 + d3d9.build.json provenance per build; headset acceptance per STATUS.md, varies by branch",
      "validation": {"arch": "PE32", "machine": "0x014C", "sha256": null},
      "deps": ["openxr-loader"],
      "rollback": "restore backed-up original d3d9.dll (game ships none; absence also valid)"
    },
    {
      "id": "openxr-loader",
      "kind": "dll",
      "profile": "core",
      "required": true,
      "feature": "OpenXR API (loaded by d3d9.dll)",
      "source": {"type": "sdk", "path": "OPENXR_SDK native/Win32/release/bin/openxr_loader.dll", "resolver": "tools/Resolve-OpenXrSdk.ps1"},
      "dest": "Binaries/openxr_loader.dll",
      "redistributable": "needs-license-review",
      "readiness": "offline-tested",
      "evidence": "THIRD-PARTY-NOTICES.txt; build links against SDK lib",
      "validation": {"arch": "PE32"},
      "deps": [],
      "rollback": "remove if installer added it"
    },
    {
      "id": "vr-ini",
      "kind": "config",
      "profile": "core",
      "required": true,
      "feature": "all runtime tuning + feature flags",
      "source": {"type": "repo", "path": "spikes/view_matrix/SingularityVR.ini"},
      "dest": "Binaries/SingularityVR.ini",
      "redistributable": true,
      "readiness": "needs-main-acceptance",
      "evidence": "shipping defaults equal tested config per STATUS 2026-08-08 note",
      "validation": {"format": "ini"},
      "deps": [],
      "rollback": "restore user/backed-up INI; updates must preserve user keys (installer merges, never overwrites)"
    },
    {
      "id": "texture-injector-dll",
      "kind": "tree",
      "profile": "core",
      "required": false,
      "feature": "DDS texture injector hook (game loads it as dinput8)",
      "source": {"type": "branch-artifacts", "branch": "assets texture pipeline", "outputs": ["dinput8.dll"]},
      "dest": "Binaries/dinput8.dll",
      "redistributable": true,
      "readiness": "offline-tested",
      "evidence": "injector /O2 verification preflight + pipeline regression tests (assets branch)",
      "validation": {"arch": "PE32"},
      "deps": [],
      "rollback": "remove dinput8.dll if added; game runs without injector"
    },
    {
      "id": "texture-injector-ini",
      "kind": "tree",
      "profile": "core",
      "required": false,
      "feature": "Injector tier selection ([TextureQuality] 2x/4K/8K)",
      "source": {"type": "branch-artifacts", "branch": "assets texture pipeline", "outputs": ["texture_override.ini"]},
      "dest": "Binaries/texture_override.ini",
      "redistributable": true,
      "readiness": "offline-tested",
      "evidence": "sibling INI owned by the injector, never SingularityVR.ini (code comment, d3d9.cpp)",
      "validation": {"format": "ini"},
      "deps": ["texture-injector-dll"],
      "rollback": "remove texture_override.ini if added"
    },
    {
      "id": "pl-text-pack",
      "kind": "localization",
      "profile": "localization",
      "required": false,
      "feature": "Polish story/UI/voice text maps read by the DLL at runtime",
      "source": {"type": "generated", "from": ["localization/pl/polish_story_voice.jsonl"], "generator": "tools/localization (TBD pack step)"},
      "dest": "Binaries/vr-assets/localization/pl/{polish_story_voice.jsonl,polish_text.jsonl,polish_voice.jsonl}",
      "redistributable": true,
      "readiness": "needs-correction",
      "evidence": "1672 story rows all with PL text but 1630/1672 machine_draft; see tools/localization/GAPS.md",
      "validation": {"format": "jsonl-per-line"},
      "deps": ["d3d9-dll"],
      "rollback": "remove vr-assets/localization tree if added"
    },
    {
      "id": "pl-story-audio",
      "kind": "audio",
      "profile": "localization",
      "required": false,
      "feature": "Polish story dialogue WAVs + native bank replacements",
      "source": {"type": "generated", "from": ["audio/polish/story_voicepack_xlingual (992)", "native bank replace flags"]},
      "dest": "Binaries/vr-assets/audio/polish/story/",
      "redistributable": "needs-rights-review",
      "readiness": "needs-human-listening",
      "evidence": "ASR QA only; 1557/1672 rows native_replaced=1 (integration not visually verified); see GAPS.md",
      "validation": {"format": "wav-pcm-16bit-48khz-mono"},
      "deps": ["pl-text-pack"],
      "rollback": "remove installed WAVs listed in install manifest"
    },
    {
      "id": "pl-ui-audio",
      "kind": "audio",
      "profile": "localization",
      "required": false,
      "feature": "Polish UI prompts/IMS barks/intro/MP speech",
      "source": {"type": "generated", "from": ["remaining-voices barks/mp/intro/vignette manifests", "audio/polish/cast_legal_20261014"]},
      "dest": "Binaries/vr-assets/audio/polish/ui/",
      "redistributable": "needs-rights-review",
      "readiness": "needs-human-listening",
      "evidence": "bark/mp/intro/vignette/skipped manifests; counts in GAPS.md; MP is separate optional scope",
      "validation": {"format": "wav-pcm-16bit-48khz-mono"},
      "deps": ["pl-text-pack"],
      "rollback": "remove installed WAVs listed in install manifest"
    },
    {
      "id": "texture-tier",
      "kind": "texture-tier",
      "profile": "hd-textures",
      "required": false,
      "feature": "Remastered DDS tiers selectable in VR Settings (2x/4K/8K)",
      "source": {"type": "generated", "from": ["assets texture pipeline manifests"], "tiers": ["2x", "4K"]},
      "dest": "Binaries/texture-override tiers via texture_override.ini [TextureQuality]",
      "redistributable": "user-game-derived",
      "readiness": "offline-tested",
      "evidence": "mip0 FNV gate + pipeline regression tests; 8K tier UNAVAILABLE (no 8K content anywhere)",
      "validation": {"format": "dds-dxt1-dxt5-mips", "max_proven_px": 4096},
      "deps": ["texture-injector"],
      "rollback": "reset [TextureQuality] tier; remove tier files added by installer"
    },
    {
      "id": "glove-pack",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "Baked GLB gloves + native-hand data (GloveRendererEnabled/GloveNativeEnabled)",
      "source": {"type": "branch-artifacts", "branches": ["feature/glove-animation", "side native-glove work"], "files": ["vr-assets/hud/katorga/glove-animation/native_hands.svni"]},
      "dest": "Binaries/vr-assets/hud/katorga/glove-animation/",
      "redistributable": true,
      "readiness": "experimental",
      "evidence": "L1/L2 only on side branches; headset acceptance MAIN-owned and pending",
      "validation": {"format": "svni-manifest-hash-match"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir; flags default OFF so code path is inert"
    },
    {
      "id": "knife-pack",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "Hip knife mesh + pickup/melee gesture (HipKnifeEnabled)",
      "source": {"type": "branch-artifacts", "branches": ["feature/left-hip-knife"], "files": ["vr-assets/knife/knife.svrk"]},
      "dest": "Binaries/vr-assets/knife/",
      "redistributable": true,
      "readiness": "experimental",
      "evidence": "L1 159 checks + L2 PE32; pre-TMD both hands / post-TMD right-hand rule; headset gates pending",
      "validation": {"format": "svrk-manifest-hash-match"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir; flag default OFF"
    },
    {
      "id": "ammo-plates-ammo",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "Per-gun Katorga ammo plates + live digits (AmmoPlateEnabled)",
      "source": {"type": "generated", "from": ["docs/ammo-plates.md pipeline"], "files": ["vr-assets/hud/katorga/ammo/*"]},
      "dest": "Binaries/vr-assets/hud/katorga/ammo/",
      "redistributable": true,
      "readiness": "needs-main-acceptance",
      "evidence": "L3 runtime rounds on plates branches; HUD cache mClipAmmo/mBinAmmo/mClipSize proven live",
      "validation": {"format": "png-atlas-plus-json-dims"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir; flag default OFF"
    },
    {
      "id": "ammo-plates-atlas",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "Shared plates atlas (dims + byte size verified at load)",
      "source": {"type": "generated", "from": ["docs/ammo-plates.md pipeline"], "files": ["vr-assets/hud/katorga/plates-atlas/*"]},
      "dest": "Binaries/vr-assets/hud/katorga/plates-atlas/",
      "redistributable": true,
      "readiness": "needs-main-acceptance",
      "evidence": "loader verifies installed atlas.json dims + byte size, keeps state on failure (code comment)",
      "validation": {"format": "png-atlas-plus-json-dims"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir; flag default OFF"
    },
    {
      "id": "health-plate",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "Wrist health plate (two-hand plate, gesture-gated)",
      "source": {"type": "generated", "from": ["vr-assets/hud/katorga/3d/*"]},
      "dest": "Binaries/vr-assets/hud/katorga/3d/",
      "redistributable": true,
      "readiness": "experimental",
      "evidence": "side branch work only; acceptance pending",
      "validation": {"format": "png-atlas-plus-json-dims"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir; flag default OFF"
    },
    {
      "id": "vr-bik-boot",
      "kind": "bik",
      "profile": "experimental",
      "required": false,
      "feature": "VR boot logo movie (pre-menu card + first film are one asset)",
      "source": {"type": "branch-artifacts", "branches": ["fix/boot-logo-vya-suffix", "side/bink-stills-vr"], "install_as": "RvGame/Movies/SNG_logo.bik"},
      "dest": "RvGame/Movies/SNG_logo.bik",
      "redistributable": "user-game-derived",
      "readiness": "offline-tested",
      "evidence": "BIKi geometry/fps/audio/decode validation vs stock; runtime acceptance MAIN-owned",
      "validation": {"format": "bink1-1280x720-fps-match-stock-audio-layout"},
      "deps": [],
      "rollback": "restore stock .bik from timestamped backup + re-hash (never ship without stock backup)"
    },
    {
      "id": "vr-bik-loading",
      "kind": "bik",
      "profile": "experimental",
      "required": false,
      "feature": "VR loading-screen movie",
      "source": {"type": "branch-artifacts", "branches": ["fix/boot-logo-vya-suffix", "side/bink-stills-vr"], "install_as": "RvGame/Movies/loading_screen.bik"},
      "dest": "RvGame/Movies/loading_screen.bik",
      "redistributable": "user-game-derived",
      "readiness": "offline-tested",
      "evidence": "BIKi 1280x720/24fps/48f/no-audio validation vs stock; 4K variant explicitly experimental (never slot-proven)",
      "validation": {"format": "bink1-1280x720-24fps-no-audio"},
      "deps": [],
      "rollback": "restore stock .bik from timestamped backup + re-hash"
    },
    {
      "id": "ps-prompts",
      "kind": "asset-pack",
      "profile": "experimental",
      "required": false,
      "feature": "PlayStation prompt icons (replacing Xbox glyphs)",
      "source": {"type": "branch-artifacts", "branches": ["ps-prompt-icons work"]},
      "dest": "Binaries/vr-assets/hud/prompts/",
      "redistributable": "needs-license-review",
      "evidence": "glyph replacement research on assets branch; integration pending",
      "validation": {"format": "png"},
      "deps": ["d3d9-dll"],
      "rollback": "remove pack dir"
    },
    {
      "id": "fonts",
      "kind": "exclusion",
      "profile": "core",
      "required": false,
      "feature": "UI text rendering uses a procedural 5x7 bitmap font in code",
      "source": {"type": "none", "reason": "no font files exist or are needed; glyph coverage is a code table"},
      "dest": null,
      "redistributable": true,
      "readiness": "accepted",
      "evidence": "d3d9.cpp panel/popup text paths; missing glyphs render as space (documented behavior)",
      "validation": {},
      "deps": [],
      "rollback": "not applicable"
    }
  ]
}
